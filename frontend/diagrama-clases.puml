' ===== HERENCIA: entidades de dominio =====
User --|> BaseEntity
PlayerStats --|> BaseEntity
Match --|> BaseEntity
GameRoom --|> BaseEntity

' ===== HERENCIA: servicios =====
AuthService --|> BaseService
UserService --|> BaseService
MatchService --|> BaseService
LeaderboardService --|> BaseService
AdminService --|> BaseService
AdminUserService --|> BaseService
AdminContentService --|> BaseService
AdminAnalyticsService --|> BaseService
AuditLogService --|> BaseService

' ===== HERENCIA: repositorios =====
UserRepository --|> BaseRepository
MatchRepository --|> BaseRepository
PlayerStatsRepository --|> BaseRepository
RoomRepository --|> BaseRepository

' ===== REALIZACION de interfaces =====
BaseRepository ..|> ICrudRepository
BaseGameModeStrategy ..|> IGameModeStrategy
PairsModeStrategy --|> BaseGameModeStrategy
TriadsModeStrategy --|> BaseGameModeStrategy
InfiniteModeStrategy --|> BaseGameModeStrategy
ChallengeModeStrategy --|> BaseGameModeStrategy
BossModeStrategy --|> BaseGameModeStrategy
MultiplayerModeStrategy --|> BaseGameModeStrategy
AiFriendsModeStrategy --|> BaseGameModeStrategy
RoomManager ..|> IRoomManager
GameModeFactory ..> IGameModeStrategy : crea / registra

' ===== COMPOSICION =====
RoomManager *-- GameRoom : contiene
GameRoom *-- Player : compone

' ===== DEPENDENCIAS del motor (Command + DIP) =====
RoomCommandHandler ..> GameEngine : delega la partida
RoomCommandHandler ..> IRoomManager : valida y muta
GameEngine ..> IRoomManager : depende de la interfaz
GameEngine ..> TurnTimer
GameEngine ..> DeckGenerator : genera el mazo
GameEngine ..> GameRoom : resuelve sobre el dominio
GameRoom ..> GameModeFactory : reglas por modo
RoomManager ..> IRoomRepository : persiste via interfaz

' ===== DEPENDENCIAS de servicios (DIP) =====
AuthService ..> UserRepository
UserService ..> UserRepository
UserService ..> InventoryRepository
MatchService ..> MatchRepository
LeaderboardService ..> UserRepository
LeaderboardService ..> PlayerStatsRepository
AdminUserService ..> UserRepository
AdminAnalyticsService ..> AnalyticsRepository
AuditLogService ..> AdminLogRepository
AdminService ..> AdminUserService
AdminService ..> AdminContentService
AdminService ..> AdminAnalyticsService
AdminService ..> AuditLogService

@enduml
