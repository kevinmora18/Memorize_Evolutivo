@startuml
title Diagrama de Clases - Memorize (Backend: Multijugador + Motor de juego)
hide circle
skinparam classAttributeIconSize 0
skinparam backgroundColor #0b0f1a
skinparam classBackgroundColor #111a2c
skinparam classBorderColor #3b4f77
skinparam classFontColor #e5e7eb
skinparam classAttributeFontColor #cbd5e1
skinparam classAttributeFontSize 11
skinparam classFontSize 13
skinparam interfaceBackgroundColor #1a1030
skinparam interfaceBorderColor #7c5cff
skinparam stereotypeCBackgroundColor #0e2038
skinparam stereotypeFontColor #93c5fd
skinparam defaultFontName Consolas
skinparam shadowing false
skinparam nodesep 16
skinparam ranksep 30

legend right
  <color:#a78bfa>--|></color> Herencia (extends)
  <color:#7c5cff>..|></color> Realizacion (implements)
  <color:#fbbf24>--*</color> Composicion (tiene)
  <color:#34d399>..></color> Dependencia (usa)
endlegend

package "Abstracciones base - src/core/" #0e1626 {

  abstract class BaseEntity<TData> {
    # readonly id: string
    # readonly createdAt: Date
    # _updatedAt?: Date
    + get updatedAt(): Date
    # touch(): void
    + {abstract} toJSON(): TData
  }

  abstract class BaseService {
    # serviceName: string
    # log(msg, level): void
    # handleError(e, ctx): never
    + {abstract} initialize(): Promise<void>
  }

  abstract class BaseRepository<T, ID> {
    # prisma: PrismaClient
    # modelName: string
    + {abstract} findById(id: ID): Promise<T>
    + {abstract} create(data): Promise<T>
    + {abstract} update(id, data): Promise<T>
    + {abstract} delete(id: ID): Promise<void>
    + {abstract} findAll(opts?): Promise<T[]>
    # log(msg): void
  }

  abstract class BaseController {
    # controllerName: string
    # sendSuccess(res, data, code?): void
    # sendCreated(res, data): void
    # sendError(res, msg, code?): void
    # handleHttpError(res, err, msg?): void
  }
}

package "Interfaces - src/core/interfaces/" #1a1030 {

  interface IGameModeStrategy {
    + modeName: string
    + getRequiredFlipsCount(): number
    + checkMatch(flipped, idx): IMatchCheckResult
    + calculateXp(score, won): number
    + calculateCoins(score, won): number
  }

  interface ICrudRepository<T, ID> {
    + findById(id: ID): Promise<T>
    + findAll(opts?): Promise<T[]>
    + create(data): Promise<T>
    + update(id, data): Promise<T>
    + delete(id: ID): Promise<void>
  }

  interface IRoomRepository {
    + save(room): Promise<void>
    + saveFinal(room, winnerId): Promise<void>
    + findByCodeOrId(search): Promise<GameRoom>
    + findActiveRooms(): Promise<GameRoom[]>
  }

  interface IRoomManager {
    + createRoom(data): GameRoom
    + getRoom(idOrCode): GameRoom
    + deleteRoom(id): boolean
    + getAvailableRooms(filters?): GameRoom[]
    + joinRoom(id, player, pw?): GameRoom
    + leaveRoom(id, playerId): void
    + persistRoom(room): Promise<void>
    + persistFinal(room, winnerId): Promise<void>
    + recoverActiveRooms(): Promise<void>
  }
}

