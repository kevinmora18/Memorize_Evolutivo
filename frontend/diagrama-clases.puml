package "Motor de juego - src/engine/ , src/managers/" #10203a {

  class RoomCommandHandler {
    - roomManager: IRoomManager
    - engine: GameEngine
    + handle(socket, command, payload): CommandOutcome
    - join/leave/ready/start/flip(...): CommandOutcome
    - emote/rematch/chat/reconnect/disconnect(...)
    - memberRoom(socket, id, ev): GameRoom
  }

  class GameEngine {
    - turnTimer: TurnTimer
    - evaluating: Set<string>
    - pendingResolve: Map<string, Timeout>
    + startGame(room, mode, count): CommandOutcome
    + flipCard(room, playerId, idx): CommandOutcome
    + expireTurn(roomId): void
    + resolveTurn(room): CommandOutcome
    + shutdown(): void
    - armTurnTimer(roomId, playerId, mode): void
    - scheduleResolve(room): void
  }

  class TurnTimer {
    - timers: Map<string, Timeout>
    + start(roomId, sec, onExpire): void
    + stop(roomId): void
    + has(roomId): boolean
    + stopAll(): void
  }

  class DeckGenerator <<module>> {
    + generateDeck(seed, mode, count): ServerDeckCard[]
    + cardKey(seed, faceId): string
  }

  class RoomManager <<Singleton>> {
    - {static} instance: RoomManager
    - rooms: Map<string, GameRoom>
    - repo?: IRoomRepository
    - {static} getInstance(repo?): RoomManager
    + createRoom(data): GameRoom
    + getRoom(idOrCode): GameRoom
    + hasRoom(idOrCode): boolean
    + deleteRoom(id): boolean
    + getAvailableRooms(filters?): GameRoom[]
    + joinRoom(id, player, pw?): GameRoom
    + leaveRoom(id, playerId): void
    + getStats(): object
    + persistRoom(room): Promise<void>
    + persistFinal(room, winnerId): Promise<void>
    + recoverActiveRooms(): Promise<void>
    - cleanupOldRooms(): void
    - generateRoomId(): string
  }
}

package "Patron Strategy / Factory - src/models/strategies/" #2a1a0e {

  abstract class BaseGameModeStrategy {
    + {abstract} modeName: string
    + {abstract} requiredFlips: number
    + {abstract} baseExp: number
    + getRequiredFlipsCount(): number
    + checkMatch(flipped, idx): IMatchCheckResult
    + calculateXp(score, won): number
    + calculateCoins(score, won): number
  }

  class PairsModeStrategy
  class TriadsModeStrategy
  class InfiniteModeStrategy
  class ChallengeModeStrategy
  class BossModeStrategy
  class MultiplayerModeStrategy
  class AiFriendsModeStrategy

  class GameModeFactory <<Factory>> {
    - {static} strategies: Map<string, IGameModeStrategy>
    + {static} getStrategy(mode): IGameModeStrategy
    + {static} registerStrategy(name, s): void
  }
}

